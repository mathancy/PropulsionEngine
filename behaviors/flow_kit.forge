// flow_kit.forge: the flow nodes (do once, do N, flip flop, gate, switch, timeline), one action each.

header:
	needs component:Transform

	variable name:Hellos type:integer value:0
	variable name:Warmups type:integer value:0
	variable name:Lefts type:integer value:0
	variable name:Rights type:integer value:0
	variable name:Passes type:integer value:0
	variable name:Word type:text value:""
	variable name:Start type:vector3 x:0 y:0 z:0
	variable name:Goal type:vector3 x:10 y:0 z:0
	variable name:Frames type:integer value:0
	variable name:Door type:gate value:closed

implement:
	action Greet:
		only once as Greeting:
			add 1 to Hellos

	action Warm:
		first 3 times as Warmup:
			add 1 to Warmups

	action Rearm:
		reset Greeting
		reset Warmup

	action Step:
		alternate:
			add 1 to Lefts
		otherwise:
			add 1 to Rights

	action Pass:
		through Door:
			add 1 to Passes

	action Unlock:
		open Door

	action Lock:
		close Door

	action Flip:
		toggle Door

	action Name value:integer:
		choose value:
			case 1:
				make Word "one"
			case 2 or 3:
				make Word "few"
			otherwise:
				make Word "many"

	action Spell word:text:
		choose word:
			case "a":
				make Word "first"
			case "b":
				make Word "second"

	action Rise:
		animate Height from 0.0 to 4.0 over 2 seconds:
			make Transform.Loc.Y Height
			add 1 to Frames

	action Travel:
		animate Spot from Start to Goal over 1 second:
			make Transform.Loc Spot
