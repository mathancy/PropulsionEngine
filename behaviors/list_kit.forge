// list_kit.forge: the list nodes, one action each.

header:
	variable name:Items type:list of integer

implement:
	action Add value:integer:
		add value to Items, if new

	action AddAnyway value:integer:
		add value to Items

	action Drop index:integer:
		remove item index from Items

	action Wipe:
		clear Items

	action Has value:integer gives boolean:
		remember Found Items contains value
		give back Found is true

	action Lacks value:integer gives boolean:
		remember Missing Items does not contain value
		give back Missing is true

	action Where value:integer gives integer:
		give back position of value in Items

	action Total gives integer:
		give back count of Items
