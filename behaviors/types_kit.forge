// types_kit.forge: enums, structs, tables and traces, one action each.

header:
	needs component:Transform

	enum name:Mode values:Idle Chasing Attacking

	struct name:Item
		field name:Name type:text
		field name:Cost type:integer
		field name:Spot type:vector3
		field name:Stance type:Mode

	table name:Items type:Item
		row key:"Sword" Name:"Sword" Cost:5 Stance:Attacking
		row key:"Shield" Name:"Shield" Cost:8

	variable name:State type:Mode
	variable name:Held type:Item
	variable name:Bag type:list of Item
	variable name:Last type:hit

implement:
	action Chase:
		make State Chasing

	action Describe gives text:
		choose State:
			case Idle:
				give back "idle"
			case Chasing:
				give back "chasing"
			otherwise:
				give back "attacking"

	action IsIdle gives boolean:
		give back State is Idle

	action Label gives text:
		give back text of State

	action Pick key:text:
		make Held row key of Items
		add Held to Bag

	action Craft cost:integer:
		make Held new Item Name:"Custom" Cost:cost

	action Price gives integer:
		give back Held.Cost

	action Discount amount:integer:
		subtract amount from Held.Cost

	action Rename word:text:
		make Held.Name word

	action Shift distance:decimal:
		make Held.Spot.X distance

	action Stance gives Mode:
		give back Held.Stance

	action Count gives integer:
		give back count of Bag

	action Scan start:vector3 end:vector3:
		make Last trace from start to end

	action Sweep start:vector3 end:vector3 width:decimal:
		make Last sweep from start to end radius width

	action Seen gives boolean:
		give back Last.Blocked is true

	action Who gives entity:
		give back Last.Entity

	action HowFar gives decimal:
		give back Last.Distance

	action Surface gives vector3:
		give back Last.Normal
