{
	"name": "forgescript",
	"displayName": "ForgeScript",
	"description": "Syntax highlighting, live error checking, and code intelligence (hover, go to definition, rename, completion) for ForgeScript (.forge) files.",
	"version": "0.3.0",
	"publisher": "forge",
	"license": "UNLICENSED",
	"engines": {
		"vscode": "^1.82.0"
	},
	"categories": [
		"Programming Languages"
	],
	"contributes": {
		"languages": [
			{
				"id": "forgescript",
				"aliases": [
					"ForgeScript",
					"forgescript"
				],
				"extensions": [
					".forge"
				],
				"configuration": "./language-configuration.json"
			}
		],
		"grammars": [
			{
				"language": "forgescript",
				"scopeName": "source.forgescript",
				"path": "./syntaxes/forgescript.tmLanguage.json"
			}
		],
		"configurationDefaults": {
			"editor.tokenColorCustomizations": {
				"textMateRules": [
					{
						"scope": [
							"comment.line.double-slash.forgescript",
							"comment.line.double-slash.node-marker.forgescript"
						],
						"settings": {
							"foreground": "#E5C07B"
						}
					}
				]
			},
			"[forgescript]": {
				"editor.insertSpaces": false,
				"editor.detectIndentation": false,
				"editor.tabSize": 4,
				"editor.renderWhitespace": "boundary",
				"editor.wordBasedSuggestions": "currentDocument",
				"editor.semanticHighlighting.enabled": true
			}
		},
		"commands": [
			{
				"command": "forgescript.restartServer",
				"title": "ForgeScript: Restart Language Server"
			}
		],
		"configuration": {
			"title": "ForgeScript",
			"properties": {
				"forgescript.serverPath": {
					"type": "string",
					"default": "",
					"markdownDescription": "Full path to the `forge-lsp` executable. Leave empty to use `target/release/forge-lsp` (or `debug`) in an open workspace folder."
				}
			}
		},
		"semanticTokenScopes": [
			{
				"language": "forgescript",
				"scopes": {
					"variable": [
						"variable.other.forgescript"
					],
					"variable.readonly": [
						"variable.other.constant.forgescript"
					],
					"parameter": [
						"variable.parameter.forgescript"
					],
					"function": [
						"entity.name.function.forgescript"
					],
					"event": [
						"entity.name.tag.forgescript"
					],
					"class": [
						"entity.name.type.class.forgescript"
					],
					"interface": [
						"entity.name.type.interface.forgescript"
					],
					"namespace": [
						"entity.name.namespace.forgescript"
					],
					"property": [
						"variable.other.property.forgescript"
					]
				}
			}
		]
	},
	"main": "./extension.js",
	"activationEvents": [
		"onLanguage:forgescript"
	],
	"dependencies": {
		"vscode-languageclient": "^9.0.1"
	}
}
