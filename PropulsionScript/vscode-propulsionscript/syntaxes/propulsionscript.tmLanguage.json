{
	"$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
	"name": "PropulsionScript",
	"scopeName": "source.propulsionscript",
	"patterns": [
		{ "include": "#node-marker" },
		{ "include": "#comment" },
		{ "include": "#string" },
		{ "include": "#section" },
		{ "include": "#boolean" },
		{ "include": "#declared-name" },
		{ "include": "#declared-reference" },
		{ "include": "#key" },
		{ "include": "#action-definition" },
		{ "include": "#do-call" },
		{ "include": "#result-of" },
		{ "include": "#as-name" },
		{ "include": "#self" },
		{ "include": "#field-path" },
		{ "include": "#phrase" },
		{ "include": "#type" },
		{ "include": "#declaration" },
		{ "include": "#control" },
		{ "include": "#statement" },
		{ "include": "#comparison" },
		{ "include": "#operator" },
		{ "include": "#unit" },
		{ "include": "#number" },
		{ "include": "#identifier" }
	],
	"repository": {
		"node-marker": {
			"comment": "// node 6: Move Object [detail]. The tools read these (SPEC 10), so make them stand out.",
			"match": "(//)\\s*(node)\\s+(\\d+)\\s*(:)(.*)$",
			"name": "comment.line.double-slash.node-marker.propulsionscript",
			"captures": {
				"1": { "name": "punctuation.definition.comment.propulsionscript" },
				"2": { "name": "keyword.other.node-marker.propulsionscript" },
				"3": { "name": "constant.numeric.node-id.propulsionscript" },
				"4": { "name": "punctuation.separator.propulsionscript" },
				"5": { "name": "markup.italic.node-name.propulsionscript" }
			}
		},
		"comment": {
			"match": "(//).*$",
			"name": "comment.line.double-slash.propulsionscript",
			"captures": {
				"1": { "name": "punctuation.definition.comment.propulsionscript" }
			}
		},
		"string": {
			"begin": "\"",
			"end": "\"",
			"name": "string.quoted.double.propulsionscript",
			"beginCaptures": { "0": { "name": "punctuation.definition.string.begin.propulsionscript" } },
			"endCaptures": { "0": { "name": "punctuation.definition.string.end.propulsionscript" } }
		},
		"section": {
			"match": "^(header|implement)\\s*(:)",
			"captures": {
				"1": { "name": "keyword.control.section.propulsionscript" },
				"2": { "name": "punctuation.separator.propulsionscript" }
			}
		},
		"boolean": {
			"match": "\\b(true|false)\\b",
			"name": "constant.language.boolean.propulsionscript"
		},
		"declared-name": {
			"comment": "name:Health in variable / constant / event declarations",
			"match": "\\b(name)(:)([A-Za-z_][A-Za-z0-9_]*)",
			"captures": {
				"1": { "name": "variable.parameter.key.propulsionscript" },
				"2": { "name": "punctuation.separator.key-value.propulsionscript" },
				"3": { "name": "variable.other.propulsionscript" }
			}
		},
		"declared-reference": {
			"comment": "needs component:Transform / system:Audio / entity:Player / entities:Foes",
			"match": "\\b(component|system|entity|entities)(:)([A-Za-z_][A-Za-z0-9_]*)",
			"captures": {
				"1": { "name": "variable.parameter.key.propulsionscript" },
				"2": { "name": "punctuation.separator.key-value.propulsionscript" },
				"3": { "name": "entity.name.type.propulsionscript" }
			}
		},
		"key": {
			"comment": "Any named pair: type:integer, value:1, amount:10, at:vector ...",
			"match": "\\b([a-z][A-Za-z0-9_]*)(:)(?=\\S)",
			"captures": {
				"1": { "name": "variable.parameter.key.propulsionscript" },
				"2": { "name": "punctuation.separator.key-value.propulsionscript" }
			}
		},
		"action-definition": {
			"match": "\\b(action)\\s+([A-Za-z_][A-Za-z0-9_]*)",
			"captures": {
				"1": { "name": "storage.type.function.propulsionscript" },
				"2": { "name": "entity.name.function.propulsionscript" }
			}
		},
		"do-call": {
			"match": "\\b(do)\\s+([A-Za-z_][A-Za-z0-9_]*)(?:\\s+(on)\\s+([A-Za-z_][A-Za-z0-9_]*))?",
			"captures": {
				"1": { "name": "keyword.other.statement.propulsionscript" },
				"2": { "name": "entity.name.function.propulsionscript" },
				"3": { "name": "keyword.operator.word.propulsionscript" },
				"4": { "name": "entity.name.type.propulsionscript" }
			}
		},
		"result-of": {
			"match": "\\b(result\\s+of)\\s+([A-Za-z_][A-Za-z0-9_]*)",
			"captures": {
				"1": { "name": "support.function.phrase.propulsionscript" },
				"2": { "name": "entity.name.function.propulsionscript" }
			}
		},
		"as-name": {
			"match": "\\b(as)\\s+([A-Za-z_][A-Za-z0-9_]*)",
			"captures": {
				"1": { "name": "keyword.operator.word.propulsionscript" },
				"2": { "name": "entity.name.type.propulsionscript" }
			}
		},
		"self": {
			"match": "\\bSelf\\b",
			"name": "variable.language.self.propulsionscript"
		},
		"field-path": {
			"comment": "Transform.Loc.X: the only place dots appear",
			"match": "\\b([A-Z][A-Za-z0-9_]*)((?:\\.[A-Z][A-Za-z0-9_]*)+)",
			"captures": {
				"1": { "name": "entity.name.type.component.propulsionscript" },
				"2": { "name": "variable.other.property.propulsionscript" }
			}
		},
		"phrase": {
			"match": "\\b(?:time since start|of the way from|per second|distance from|count of|absolute value of|text of|decimal of|integer of|item|axis|vector|clamp|between|map|random decimal|random integer|normalized|length of|dot product of|rotation looking from|rotation|pitch|yaw|roll|forward of|right of|up of|ease|turn|not|position of|level name|cast|format|new|row|trace from|sweep from|radius)\\b",
			"name": "support.function.phrase.propulsionscript"
		},
		"type": {
			"match": "\\b(?:integer|decimal|boolean|text|vector2|vector3|color|entity|timer|gate|hit|list)\\b",
			"name": "storage.type.propulsionscript"
		},
		"declaration": {
			"match": "\\b(?:variable|constant|needs|event|tag|entry|enum|struct|table|field|values|row)\\b",
			"name": "storage.type.declaration.propulsionscript"
		},
		"control": {
			"match": "\\b(?:if|otherwise|then|while|repeat|for|each|finish|skip|stop loop|give back|after|every|when|only once|first|times|alternate|through|choose|case|animate|over|damaged|hits)\\b",
			"name": "keyword.control.propulsionscript"
		},
		"statement": {
			"match": "\\b(?:make|add|subtract|multiply|divide|remove|send|remember|reset|spawn|move|print|destroy|gives|do|clear|open|close|toggle|damage|attach|detach|tell)\\b",
			"name": "keyword.other.statement.propulsionscript"
		},
		"comparison": {
			"match": "\\bis(?:\\s+(?:not|above|below|at\\s+least|at\\s+most|missing|present|pressing))*\\b|\\b(?:starts\\s+pressing|stops\\s+pressing|stops\\s+touching|touches|sends|changes|created|destroyed|frame|contains|does not contain)\\b",
			"name": "keyword.operator.comparison.propulsionscript"
		},
		"operator": {
			"match": "\\b(?:plus|minus|times|divided by|remainder after dividing by|joined with|capped at|floored at|toward|forward|back|left|right|up|down|and|or|of|on|to|from|by|at|in)\\b",
			"name": "keyword.operator.word.propulsionscript"
		},
		"unit": {
			"match": "\\bseconds?\\b",
			"name": "keyword.other.unit.propulsionscript"
		},
		"identifier": {
			"comment": "Anything left over is a name (variable, parameter, remembered value). Must stay last.",
			"match": "\\b[A-Za-z_][A-Za-z0-9_]*\\b",
			"name": "variable.other.propulsionscript"
		},
		"number": {
			"match": "\\b\\d+(?:\\.\\d+)?\\b",
			"name": "constant.numeric.propulsionscript"
		}
	}
}
