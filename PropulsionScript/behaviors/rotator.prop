// rotator.prop: spins around its up axis. SpinSpeed is set per placed instance.

header:
	needs component:Transform

	variable name:SpinSpeed type:decimal value:45.0 exposed:true

implement:
	// node 1: On Tick
	every frame:
		// node 2: Rotate Object
		add SpinSpeed per second to Transform.Rot.Z

	// node 3: On Tick [every 2 seconds]
	every 2 seconds:
		// node 4: Print Debug Message
		print "Rotation is " joined with Transform.Rot.Z
