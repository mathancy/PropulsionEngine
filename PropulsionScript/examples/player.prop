// player.prop: movement, health, coins, and respawn for the player entity.
// (v0.2: no parentheses, field paths like Transform.Loc.Z, calls written "do X on Y".)

header:
	needs component:Transform
	// CHANGED: Input is a system, not a component, so "needs component:Input" is now "needs system:Input".
	needs system:Input
	needs file:"coin.prop" as Coin when:used
	needs file:"ui/hud.prop" as Hud when:startup

	// CHANGED: added a tag so other files can find the player with "needs entity:Player tag:"player"" (see enemy.prop).
	tag name:"player"

	constant name:MaxHealth type:integer value:100
	constant name:Speed type:decimal value:5.0
	constant name:HealingOrb type:integer value:50
	variable name:Health type:integer value:100
	variable name:Coins type:integer value:0
	variable name:IsInvincible type:boolean value:false
	// CHANGED: the vector "(0, 1, 0)" is now written with named parts.
	variable name:Spawn type:vector3 x:0 y:0 z:1
	variable name:SinceDamage type:timer
	event name:Died

implement:
	when created:
		// CHANGED: "Transform.position" is now "Transform.Loc".
		make Transform.Loc Spawn

	every frame:
		// CHANGED: "Input.moveForward is true" is now "Input is pressing moveForward".
		// CHANGED: "add Speed per second to Transform.Loc.Z" moved along the world's Z axis, which isn't "forward"
		// once the player turns (and the engine's forward is +Y). It is now "move Self forward by Speed per second".
		if Input is pressing moveForward, then move Self forward by Speed per second
		if Input is pressing moveBack, then move Self back by Speed per second

	every 5 seconds:
		if Health is below MaxHealth and SinceDamage is above 10 seconds, then do Heal

	when Self touches Coin as Pickup:
		add 1 to Coins
		// CHANGED: "Hud.ShowCoins" is now "do ShowCoins on Hud".
		do ShowCoins on Hud count:Coins
		destroy Pickup

	when Died:
		// CHANGED: "Hud.ShowMessage" is now "do ShowMessage on Hud".
		do ShowMessage on Hud text:"You died"
		do Respawn

	action TakeDamage amount:integer:
		if IsInvincible is true, then finish
		subtract amount from Health, floored at 0
		if Health is at most 0:
			send Died
		reset SinceDamage

	action Heal:
		add HealingOrb to Health, capped at MaxHealth

	action Respawn:
		make Health MaxHealth
		make Transform.Loc Spawn
		make IsInvincible true
		repeat 3 times:
			do Flash on Hud
		make IsInvincible false
