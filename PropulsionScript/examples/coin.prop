// coin.prop: a collectible that spins and reports its value.

header:
	needs component:Transform
	needs system:Audio

	constant name:SpinSpeed type:decimal value:90.0
	constant name:CoinValue type:integer value:1
	variable name:Collected type:boolean

implement:
	every frame:
		// CHANGED: "(SpinSpeed * Time.delta)" is now "SpinSpeed per second", and "Transform.rotation.y" is now "Transform.Rot.Z".
		add SpinSpeed per second to Transform.Rot.Z

	action GetValue gives integer:
		give back CoinValue

	action Collect:
		if Collected is true, then finish
		make Collected true
		// CHANGED: "Audio.Play" is now "do Play on Audio".
		do Play on Audio sound:"coin.wav"
		destroy Self
